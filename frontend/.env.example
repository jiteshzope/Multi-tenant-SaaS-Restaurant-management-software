# Copy to .env.local (or .env) before running.
# src/lib/env.ts parses these with Zod and throws at boot if one is malformed.
#
# These are read by Vite at BUILD time and inlined into the bundle. There is no
# runtime lookup, so changing them on the host requires a rebuild — on Vercel,
# set them in Project Settings > Environment Variables and redeploy.

# --- Local development ---------------------------------------------------
# Leave both blank to use the Vite dev proxy (same-origin, no CORS in dev).
VITE_API_URL=/api
VITE_SOCKET_URL=

# Pointing straight at a local API instead (no proxy):
# VITE_API_URL=http://localhost:3000/api
# VITE_SOCKET_URL=http://localhost:3000

# --- Production (Vercel) -------------------------------------------------
# The browser talks to the API directly, so the backend's CORS_ORIGIN must
# name the Vercel domain. Note the /api suffix on the first one and its
# absence on the second — socket.io appends its own /realtime namespace.
# VITE_API_URL=https://<your-backend>.up.railway.app/api
# VITE_SOCKET_URL=https://<your-backend>.up.railway.app
