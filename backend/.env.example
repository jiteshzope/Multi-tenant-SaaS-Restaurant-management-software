# ---------------------------------------------------------------------------
# Copy to .env before running anything.  env.validation.ts (zod) refuses to boot
# the app if any of these is missing or malformed.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# From the host (API running outside Docker, Postgres exposed on 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resto_saas
# From inside the compose network use:  postgresql://postgres:postgres@db:5432/resto_saas
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resto_saas_shadow

# openssl rand -hex 32   (must differ from each other)
JWT_ACCESS_SECRET=dev_access_secret_change_me_0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_fedcba9876543210
JWT_REFRESH_TTL=7d

# Argon2id cost — OWASP baseline (19 MiB, 2 passes, 1 lane)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

CORS_ORIGIN=http://localhost:5173
THROTTLE_TTL=60
THROTTLE_LIMIT=120
LOG_LEVEL=log
SWAGGER_ENABLED=true
